# Copy to .env (or export as real env vars) — never commit real secrets.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=lms_db
DB_USERNAME=lms_user
DB_PASSWORD=lms_password

JWT_SECRET=replace-with-a-random-32-byte-plus-secret
JWT_EXPIRATION_MINUTES=1440

CORS_ALLOWED_ORIGINS=http://localhost:4200

# Google Gemini API key (https://aistudio.google.com/apikey). Free tier.
# Leave empty to run with deterministic fallback recommendations only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-1.5-flash
GEMINI_TIMEOUT_SECONDS=15
